# Copy to .env.local and fill in. .env.local is gitignored.
#   cp .env.example .env.local

# Supabase — required. Without these the build fails at import time.
# Project settings → API → Project URL / anon public key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Analytics is Umami, loaded from cloud.umami.is with the website id hard-coded
# in src/app/layout.tsx. It needs no key, so there is nothing to set here.

# Cal.com — optional. Server-side only, used by /api/bookings to list
# bookings in the admin panel. The public /book embed works without it.
CAL_API_KEY=

# CRM — optional. Server-side only. /api/contact copies every enquiry and
# estimate here as a lead, before the visitor books. Left empty, it's skipped.
CREW_LEADS_URL=http://localhost:8787/integrations/custom/leads
CREW_LEADS_KEY=
